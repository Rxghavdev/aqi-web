# Copy to .env.local for local work. Placeholder values only: never commit real keys.

# Required for live data. Free key from https://www.data.gov.in/ (register, then
# Dashboard > My Account). The public sample key returns only 10 rows per call.
DATA_GOV_API_KEY=your-data-gov-in-api-key

# Rows requested per CPCB page. 10 works with the sample key; a registered key
# accepts larger pages (for example 1000), which makes a refresh much faster.
CPCB_PAGE_LIMIT=10

# The public origin, no trailing slash. Used for canonical URLs, the sitemap and
# Open Graph. A production build refuses localhost unless ALLOW_LOCAL_SITE_URL=1.
NEXT_PUBLIC_SITE_URL=https://example.com

# Set to 1 only to build and run a production build on your own machine.
# ALLOW_LOCAL_SITE_URL=1

# Optional. Ads render only when the client id and that page's slot id are set.
# Client id looks like ca-pub-xxxxxxxxxxxxxxxx. These are baked in at build time.
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-0000000000000000
# NEXT_PUBLIC_ADSENSE_SLOT_HOME=0000000000
# NEXT_PUBLIC_ADSENSE_SLOT_CITY=0000000000

# Optional. Contact address shown on the About and Privacy pages. Omit to hide it.
# NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com

# Optional. Ship the Content-Security-Policy as report-only (nothing is blocked)
# while checking a new deployment. Baked in at build time.
# CSP_REPORT_ONLY=1
