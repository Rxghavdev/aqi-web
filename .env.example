# Free key from https://www.data.gov.in/ (register, then Dashboard → My Account).
# The public sample key only returns 10 rows per call. A registered key can page faster.
DATA_GOV_API_KEY=
CPCB_PAGE_LIMIT=10

# Used for canonical URLs, sitemap, and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Ads render only when both the client id and a slot id are set.
# Client id looks like ca-pub-xxxxxxxxxxxxxxxx
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_CITY=

# Optional. Reserved for a closer open sensor feed. The site works without it.
OPENAQ_API_KEY=
